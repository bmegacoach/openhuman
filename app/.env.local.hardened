# OpenHuman — Hardened .env.local for bmegacoach ecosystem manager use.
# Generated 2026-05-15 from the 3-report audit (community + security + arch).
#
# To use: copy to `app/.env.local` (verbatim, no edits required).
# Re-review every quarter and after every OpenHuman version bump.
#
# Threat model: this machine MUST NOT hold the CAMP deployer EOA or any
# production write-scope OAuth tokens during the first 60-90 days of
# operation. See INSTALL_OPENHUMAN.md for the credential isolation plan.

# ─────────────────────────────────────────────────────────────
# Core process — keep localhost only (mitigates H-2 / SSE eavesdrop risk)
# ─────────────────────────────────────────────────────────────
OPENHUMAN_CORE_HOST=127.0.0.1
OPENHUMAN_CORE_PORT=7788
OPENHUMAN_CORE_RPC_URL=http://127.0.0.1:7788/rpc

# Bearer token blank → desktop core auto-issues + writes to ~/.openhuman/core.token (0o600).
# DO NOT set this to a literal value here; let the supervisor generate it.
OPENHUMAN_CORE_TOKEN=

# ─────────────────────────────────────────────────────────────
# Auto-update — disable agent-initiated self-updates (M-5 mitigation)
# ─────────────────────────────────────────────────────────────
# An LLM responding to a prompt-injected integration payload could otherwise
# convince itself to apply a tampered update. Updates only via human-driven
# UI action.
OPENHUMAN_AUTO_UPDATE_RPC_MUTATIONS_ENABLED=false

# ─────────────────────────────────────────────────────────────
# Analytics + telemetry — fully disabled (L-8 mitigation)
# ─────────────────────────────────────────────────────────────
# Sentry stack traces may include credential fragments if the scrub rules
# miss a pattern. Until we have an audited scrub policy, no telemetry.
OPENHUMAN_ANALYTICS_ENABLED=false
VITE_GA_MEASUREMENT_ID=
VITE_SENTRY_DSN=

# ─────────────────────────────────────────────────────────────
# Tool execution autonomy — keep at Supervised (M-7 mitigation)
# ─────────────────────────────────────────────────────────────
# Shell tool + browser tool + integration-write tools all require human
# confirmation. Graduate to SemiAutonomous after 60-90 days, only for
# specific low-risk agents (e.g., daily briefer with read-only scopes).
OPENHUMAN_SECURITY_AUTONOMY_LEVEL=supervised

# Hard-cap shell tool runtime as a defense against runaway commands.
OPENHUMAN_TOOL_TIMEOUT_SECS=120

# Block all browser navigation outside an explicit allowlist (default 0 = blocked).
OPENHUMAN_BROWSER_ALLOW_ALL=0

# Don't write LLM prompts to logs (could leak credential context).
OPENHUMAN_LOG_PROMPTS=0

# ─────────────────────────────────────────────────────────────
# Workspace + memory
# ─────────────────────────────────────────────────────────────
# Default workspace at ~/.openhuman is fine for personal use.
# For the dedicated Windows user account, this becomes
# C:\Users\troy-openhuman\.openhuman — fully isolated from the main account.
# OPENHUMAN_WORKSPACE=

# Default model temperature.
OPENHUMAN_TEMPERATURE=0.7

# ─────────────────────────────────────────────────────────────
# Web search
# ─────────────────────────────────────────────────────────────
OPENHUMAN_WEB_SEARCH_MAX_RESULTS=5
OPENHUMAN_WEB_SEARCH_TIMEOUT_SECS=10

# ─────────────────────────────────────────────────────────────
# Proxy — leave disabled unless your network requires it
# ─────────────────────────────────────────────────────────────
OPENHUMAN_PROXY_ENABLED=false

# ─────────────────────────────────────────────────────────────
# Backend — leave defaults; this is the api.tinyhumans.ai OAuth proxy
# ─────────────────────────────────────────────────────────────
# Composio integrations route through this. If you ever want to fully
# self-host away from the tinyhumans.ai backend, that's a separate
# infrastructure decision. For Day 1, default backend is fine because
# we're only connecting read-only integrations.
# BACKEND_URL=https://api.tinyhumans.ai
# VITE_BACKEND_URL=https://api.tinyhumans.ai

# Session JWT — leave blank, the desktop login flow will set it.
JWT_TOKEN=
